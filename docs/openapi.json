{
  "openapi": "3.1.0",
  "info": {
    "title": "Operations Agent Harness",
    "description": "Persistent operations runs with approval and bounded execution.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/scenarios": {
      "get": {
        "summary": "Scenarios",
        "operationId": "scenarios_scenarios_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/runs": {
      "post": {
        "summary": "Create Run",
        "operationId": "create_run_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/runs/{session_id}": {
      "get": {
        "summary": "Get Run",
        "operationId": "get_run_runs__session_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{session_id}/events": {
      "get": {
        "summary": "Events",
        "operationId": "events_runs__session_id__events_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{session_id}/incidents": {
      "get": {
        "summary": "Incidents",
        "operationId": "incidents_runs__session_id__incidents_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{session_id}/trace.jsonl": {
      "get": {
        "summary": "Trace",
        "operationId": "trace_runs__session_id__trace_jsonl_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{session_id}/approvals/{approval_id}": {
      "post": {
        "summary": "Approve",
        "operationId": "approve_runs__session_id__approvals__approval_id__post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          },
          {
            "name": "approval_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Approval Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{session_id}/cancel": {
      "post": {
        "summary": "Cancel",
        "operationId": "cancel_runs__session_id__cancel_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentState"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgentState": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "objective": {
            "type": "string",
            "title": "Objective"
          },
          "status": {
            "$ref": "#/components/schemas/AgentStatus",
            "default": "RUNNING"
          },
          "current_step": {
            "type": "integer",
            "title": "Current Step",
            "default": 0
          },
          "pending_tool_call": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PendingToolCall"
              },
              {
                "type": "null"
              }
            ]
          },
          "traces": {
            "items": {
              "$ref": "#/components/schemas/StepTrace"
            },
            "type": "array",
            "title": "Traces"
          },
          "final_answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Answer"
          },
          "owner_id": {
            "type": "string",
            "title": "Owner Id",
            "default": "local-user"
          },
          "scenario_id": {
            "type": "string",
            "title": "Scenario Id",
            "default": "incident"
          },
          "stop_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stop Reason"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "title": "Messages"
          },
          "limits": {
            "$ref": "#/components/schemas/ExecutionLimits"
          },
          "tool_attempts": {
            "type": "integer",
            "title": "Tool Attempts",
            "default": 0
          },
          "consecutive_parse_failures": {
            "type": "integer",
            "title": "Consecutive Parse Failures",
            "default": 0
          },
          "consecutive_model_failures": {
            "type": "integer",
            "title": "Consecutive Model Failures",
            "default": 0
          },
          "active_seconds": {
            "type": "number",
            "title": "Active Seconds",
            "default": 0.0
          },
          "active_started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Started At"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          },
          "incident_creation_rejected": {
            "type": "boolean",
            "title": "Incident Creation Rejected",
            "default": false
          },
          "observations": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Observations"
          },
          "revision": {
            "type": "integer",
            "title": "Revision",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "objective"
        ],
        "title": "AgentState"
      },
      "AgentStatus": {
        "type": "string",
        "enum": [
          "RUNNING",
          "AWAITING_APPROVAL",
          "COMPLETED",
          "FAILED",
          "LIMIT_EXCEEDED",
          "STOPPED",
          "NEEDS_REVIEW"
        ],
        "title": "AgentStatus"
      },
      "ApprovalRequest": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision"
          },
          "parameters_hash": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[a-f0-9]+$",
            "title": "Parameters Hash"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "parameters_hash"
        ],
        "title": "ApprovalRequest"
      },
      "CancelRequest": {
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Reason",
            "default": "Cancelled by user"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CancelRequest"
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "ExecutionLimits": {
        "properties": {
          "max_steps": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Max Steps",
            "default": 8
          },
          "max_execution_seconds": {
            "type": "number",
            "maximum": 3600.0,
            "exclusiveMinimum": 0.0,
            "title": "Max Execution Seconds",
            "default": 30.0
          },
          "max_tool_attempts": {
            "type": "integer",
            "maximum": 300.0,
            "minimum": 1.0,
            "title": "Max Tool Attempts",
            "default": 16
          },
          "model_timeout_seconds": {
            "type": "number",
            "maximum": 300.0,
            "exclusiveMinimum": 0.0,
            "title": "Model Timeout Seconds",
            "default": 15.0
          },
          "tool_timeout_seconds": {
            "type": "number",
            "maximum": 120.0,
            "exclusiveMinimum": 0.0,
            "title": "Tool Timeout Seconds",
            "default": 3.0
          },
          "max_retries": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Max Retries",
            "default": 2
          },
          "backoff_seconds": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Backoff Seconds",
            "default": 0.05
          },
          "max_parse_failures": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 1.0,
            "title": "Max Parse Failures",
            "default": 2
          },
          "approval_ttl_seconds": {
            "type": "integer",
            "maximum": 86400.0,
            "minimum": 1.0,
            "title": "Approval Ttl Seconds",
            "default": 900
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ExecutionLimits"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PendingToolCall": {
        "properties": {
          "action_id": {
            "type": "string",
            "title": "Action Id"
          },
          "tool_name": {
            "type": "string",
            "enum": [
              "search_knowledge_base",
              "get_service_status",
              "create_incident"
            ],
            "title": "Tool Name"
          },
          "tool_args": {
            "additionalProperties": true,
            "type": "object",
            "title": "Tool Args"
          },
          "parameters_hash": {
            "type": "string",
            "title": "Parameters Hash"
          },
          "thought": {
            "type": "string",
            "title": "Thought"
          },
          "approval_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Id"
          },
          "approval_status": {
            "type": "string",
            "enum": [
              "APPROVED",
              "REJECTED",
              "PENDING",
              "NOT_REQUIRED",
              "EXPIRED"
            ],
            "title": "Approval Status",
            "default": "NOT_REQUIRED"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action_id",
          "tool_name",
          "tool_args",
          "parameters_hash",
          "thought"
        ],
        "title": "PendingToolCall"
      },
      "RunCreateRequest": {
        "properties": {
          "objective": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 2,
            "title": "Objective"
          },
          "scenario_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Scenario Id",
            "default": "incident"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "objective"
        ],
        "title": "RunCreateRequest"
      },
      "StepTrace": {
        "properties": {
          "step_num": {
            "type": "integer",
            "title": "Step Num"
          },
          "thought": {
            "type": "string",
            "title": "Thought",
            "default": ""
          },
          "tool_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Name"
          },
          "tool_input": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Input"
          },
          "tool_output": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Output"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "retry_count": {
            "type": "integer",
            "title": "Retry Count",
            "default": 0
          },
          "duration_ms": {
            "type": "number",
            "title": "Duration Ms",
            "default": 0.0
          },
          "approval_status": {
            "type": "string",
            "enum": [
              "APPROVED",
              "REJECTED",
              "PENDING",
              "NOT_REQUIRED",
              "EXPIRED"
            ],
            "title": "Approval Status",
            "default": "NOT_REQUIRED"
          },
          "event_type": {
            "type": "string",
            "title": "Event Type",
            "default": "step"
          },
          "event_id": {
            "type": "string",
            "title": "Event Id",
            "default": ""
          },
          "sequence": {
            "type": "integer",
            "title": "Sequence",
            "default": 0
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "action_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "step_num"
        ],
        "title": "StepTrace"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
