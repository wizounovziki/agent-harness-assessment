  "properties": {
    "results": {
      "items": {
        "$ref": "#/$defs/KnowledgeHit"
      },
      "title": "Results",
      "type": "array"
    },
    "total_hits": {
      "minimum": 0,
      "title": "Total Hits",
      "type": "integer"
    }
  },
  "required": [
    "results",
    "total_hits"
  ],
  "title": "SearchKBOutput",
  "type": "object"
