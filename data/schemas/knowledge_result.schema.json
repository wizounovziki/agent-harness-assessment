{
  "$defs": {
    "KnowledgeHit": {
      "additionalProperties": false,
      "properties": {
        "doc_id": {
          "title": "Doc Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "title",
        "content"
      ],
      "title": "KnowledgeHit",
      "type": "object"
    }
  },
