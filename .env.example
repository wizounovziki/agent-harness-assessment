LLM_MODE=scripted
# Real mode requires an API key and a model available to your account.
OPENAI_API_KEY=
LLM_MODEL=
# Optional compatible endpoint; default is the official OpenAI endpoint.
LLM_BASE_URL=
API_TOKEN=local-demo-token
DATABASE_PATH=runtime/harness.sqlite3
TRACE_DIR=runtime/traces
DATASET_PATH=data
MAX_STEPS=8
MAX_EXECUTION_SECONDS=30
MAX_TOOL_ATTEMPTS=16
MODEL_TIMEOUT_SECONDS=15
TOOL_TIMEOUT_SECONDS=3
MAX_RETRIES=2
BACKOFF_SECONDS=0.05
APPROVAL_TTL_SECONDS=900
