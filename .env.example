LLM_MODE=scripted
# Set real mode and deepseek for the verified provider profile.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# LLM_API_KEY is an alternative; OPENAI_API_KEY applies to openai_compatible.
LLM_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=deepseek-flash
# DeepSeek defaults to https://api.deepseek.com; generic mode uses OpenAI.
LLM_BASE_URL=
API_TOKEN=local-demo-token
DATABASE_PATH=runtime/harness.sqlite3
TRACE_DIR=runtime/traces
DATASET_PATH=data
MAX_STEPS=8
MAX_EXECUTION_SECONDS=30
MAX_TOOL_ATTEMPTS=16
MODEL_TIMEOUT_SECONDS=15
TOOL_TIMEOUT_SECONDS=3
MAX_RETRIES=2
BACKOFF_SECONDS=0.05
APPROVAL_TTL_SECONDS=900
